<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="turtlebot3_stadium_world">
    <scene>
      <shadows>false</shadows>
    </scene>
    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <light type="directional" name="lightsource1">
      <cast_shadows>true</cast_shadows>
      <pose>-1 -1 1 3.14159 -1.55 3.1419</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>0 0 -1</direction>
    </light>

    <light type="directional" name="lightsource2">
      <cast_shadows>true</cast_shadows>
      <pose>1.5 -3 1 1.57 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>0 0 -1</direction>
    </light>


    <model name="Stadium_links">
      <static>true</static>

      <!-- origin at model frame -->
      <link name="origin">
        <pose>0 0 0 0 0 0</pose>
        <visual name="origin_visual">
          <geometry><mesh><uri>model://Stadium/meshes/Stadium.dae</uri></mesh></geometry>
          <!-- <material><ambient>0.79216 0.81961 0.93333 1</ambient><diffuse>0.79216 0.81961 0.93333 1</diffuse></material> -->
        </visual>
        <collision name="origin_collision">
          <geometry><mesh><uri>model://Stadium/meshes/Stadium.dae</uri></mesh></geometry>
        </collision>
      </link>

      <!-- Child links: pose encodes the transform that was in the URDF joint/origin -->
      <link name="qr_code">
        <pose>1.44 -0.535 0.1805 0 0 -1.5708</pose>
        <visual name="qr_code_visual">
          <geometry><mesh><uri>model://Stadium/meshes/qr_code.dae</uri></mesh></geometry>
          <!-- <material><ambient>0.79216 0.81961 0.93333 1</ambient><diffuse>0.79216 0.81961 0.93333 1</diffuse></material> -->
        </visual>
        <collision name="qr_code_collision">
          <geometry><mesh><uri>model://Stadium/meshes/qr_code.dae</uri></mesh></geometry>
        </collision>
      </link>

      <link name="goal1">
        <pose>3.42 -0.18 0.181 0 0 3.1416</pose>
        <visual name="goal1_visual">
          <geometry><mesh><uri>model://Stadium/meshes/goal1.dae</uri></mesh></geometry>
          <!-- <material><ambient>0.79216 0.81961 0.93333 1</ambient><diffuse>0.79216 0.81961 0.93333 1</diffuse></material> -->
        </visual>
        <collision name="goal1_collision">
          <geometry><mesh><uri>model://Stadium/meshes/goal1.dae</uri></mesh></geometry>
        </collision>
      </link>

      <link name="goal2">
        <pose>3.42 -0.54 0.181 0 0 3.1416</pose>
        <visual name="goal2_visual">
          <geometry><mesh><uri>model://Stadium/meshes/goal2.dae</uri></mesh></geometry>
          <!-- <material><ambient>0.7921568627 0.8196078431 0.9333333333 1</ambient><diffuse>0.7921568627 0.8196078431 0.9333333333 1</diffuse></material> -->
        </visual>
        <collision name="goal2_collision">
          <geometry><mesh><uri>model://Stadium/meshes/goal2.dae</uri></mesh></geometry>
        </collision>
      </link>

      <link name="goal3">
        <pose>3.42 -0.9 0.181 0 0 3.1416</pose>
        <visual name="goal3_visual">
          <geometry><mesh><uri>model://Stadium/meshes/goal3.dae</uri></mesh></geometry>
          <!-- <material><ambient>0.79216 0.81961 0.93333 1</ambient><diffuse>0.79216 0.81961 0.93333 1</diffuse></material> -->
        </visual>
        <collision name="goal3_collision">
          <geometry><mesh><uri>model://Stadium/meshes/goal3.dae</uri></mesh></geometry>
        </collision>
      </link>

      <link name="goal4">
        <pose>3.42 -1.26 0.181 0 0 3.1416</pose>
        <visual name="goal4_visual">
          <geometry><mesh><uri>model://Stadium/meshes/goal4.dae</uri></mesh></geometry>
          <!-- <material><ambient>0.79216 0.81961 0.93333 1</ambient><diffuse>0.79216 0.81961 0.93333 1</diffuse></material> -->
        </visual>
        <collision name="goal4_collision">
          <geometry><mesh><uri>model://Stadium/meshes/goal4.dae</uri></mesh></geometry>
        </collision>
      </link>

      <link name="goal5">
        <pose>3.42 -1.62 0.181 0 0 3.1416</pose>
        <visual name="goal5_visual">
          <geometry><mesh><uri>model://Stadium/meshes/goal5.dae</uri></mesh></geometry>
          <!-- <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material> -->
        </visual>
        <collision name="goal5_collision">
          <geometry><mesh><uri>model://Stadium/meshes/goal5.dae</uri></mesh></geometry>
        </collision>
      </link>
    </model>
  </world>
</sdf>
